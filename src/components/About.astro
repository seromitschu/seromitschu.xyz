---
// src/components/About.astro
// Not: Bu bileşenin düzgün çalışması için Three.js kütüphanesinin projenize eklenmiş olması gerekmektedir.
// Kendi 3D modelinizi (JUNGLE SAFARI kazaklı çocuk) oluşturup 'public/models/memoji_child.glb' yoluna koymalısınız.
---

<section class="about-section word delay-6">
    <h2 class="section-title">Hakkımda</h2>
    
    <div class="about-layout">
        <!-- SOL TARAF: Metin Alanı (Yaş Sayacı ile) -->
        <div class="about-text">
            <p>
                Tasarım ve kodun kesiştiği noktada, insanı yormayan temiz arayüzler üretmeye odaklanıyorum. 
                Gereksiz tüm süslemelerden arındırılmış, işlevsel ve performanslı web deneyimleri geliştirmek en büyük motivasyonum. 
                Şu anda <span class="age-inline-wrapper">ben <span id="age-number">0.000000000</span> yaşındayım</span> ve çalışmalarıma Samsun'da bir geliştirici olarak devam ediyorum.
            </p>
        </div>

        <!-- SAĞ TARAF: Tamamen 3D ve Fare Takibi Yapan Karakter Kapsayıcısı -->
        <div class="memoji-container-widget">
            <div class="memoji-3d-wrapper">
                <!-- 3D MODELİ BURAYA YÜKLEMEK İÇİN CANVAS -->
                <div id="memoji-3d-canvas"></div>
            </div>
            
            <!-- Alt Paneli Kaldırıldı -->
        </div>
    </div>
</section>

<!-- THREE.JS KÜTÜPHANESİ VE YÜKLEYİCİLER - Projenizde yüklü değilse ekleyin -->
<!-- Not: Üretim ortamında cdn yerine npm paketleri kullanılması önerilir -->
<script is:inline src="https://cdn.jsdelivr.net/npm/three@0.150.0/build/three.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/three@0.150.0/examples/js/loaders/GLTFLoader.min.js"></script>

<script is:inline>
    // --- BİLEŞEN BAŞLATMA ---
    function initAboutComponent() {
        // 1. Yaş Sayaç Mantığı
        initCounters();
        
        // 2. Three.js 3D Model Yükleme ve Takip Mantığı
        initThreeJS();
    }

    // --- SAYAÇLAR ---
    function initCounters() {
        const ageEl = document.getElementById('age-number');
        const birthDate = new Date('2006-01-23T00:00:00').getTime();

        function updateAge() {
            if (!ageEl) return;
            const now = Date.now();
            const ageInMilliseconds = now - birthDate;
            const ageInYears = ageInMilliseconds / (365.25 * 24 * 60 * 60 * 1000);
            ageEl.textContent = ageInYears.toFixed(9);
        }

        // SPA geçişleri için temizleme
        if (window.aboutAgeInterval) clearInterval(window.aboutAgeInterval);
        
        window.aboutAgeInterval = setInterval(updateAge, 50);
        
        updateAge(); 
    }

    // --- THREE.JS 3D KARAKTER VE TAKİP ---
    function initThreeJS() {
        const container = document.getElementById('memoji-3d-canvas');
        if (!container || !window.THREE) {
            console.warn("3D konteyner veya Three.js bulunamadı. Model yüklenemedi.");
            return;
        }

        // 1. Sahne ve Kamera Ayarları
        const scene = new window.THREE.Scene();
        scene.background = null; // Saydam arka plan

        const camera = new window.THREE.PerspectiveCamera(45, 1, 0.1, 1000);
        camera.position.set(0, 0, 3); // Kamerayı karakterden biraz uzağa yerleştir

        // 2. Renderer Ayarları
        const renderer = new window.THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(200, 200); // Kapsayıcı boyutuna göre ayarla
        renderer.setPixelRatio(window.devicePixelRatio); // Yüksek çözünürlüklü ekranlar için
        container.appendChild(renderer.domElement);

        // 3. Aydınlatma
        const ambientLight = new window.THREE.AmbientLight(0xffffff, 0.6); // Genel yumuşak ışık
        scene.add(ambientLight);
        const directionalLight = new window.THREE.DirectionalLight(0xffffff, 1); // Yönlü sert ışık
        directionalLight.position.set(1, 2, 3);
        scene.add(directionalLight);

        // 4. 3D Modeli Yükle (GLTF/GLB)
        const loader = new window.THREE.GLTFLoader();
        let model = null;

        // ÖNEMLİ: Kendi 'memoji_child.glb' modelinizi public/models/ altına koyun.
        loader.load('/models/memoji_child.glb', (gltf) => {
            model = gltf.scene;
            scene.add(model);
            
            // Modeli ortala ve ölçeklendir
            model.scale.set(1, 1, 1); // Model boyutuna göre ayarlayın
            model.position.set(0, -0.5, 0); // Modeli biraz aşağı kaydır
            console.log("3D Model başarıyla yüklendi.");
        }, undefined, (error) => {
            console.error("3D Model yüklenirken hata oluştu. Dosya yolunu ve dosyanın varlığını kontrol edin:", error);
        });

        // 5. Fare Takip Olayı
        const mouseHandler = (e) => {
            if (!model) return;

            // Fare koordinatlarını -1 ve 1 arasına ölçekle
            const x = (e.clientX / window.innerWidth) * 2 - 1;
            const y = -(e.clientY / window.innerHeight) * 2 + 1;

            // Kafa Takibi: Modelin rotasyonunu fareye göre ayarla (LERP ile yumuşak geçiş)
            model.rotation.y = window.THREE.MathUtils.lerp(model.rotation.y, x * 0.4, 0.1); // Sağa/sola
            model.rotation.x = window.THREE.MathUtils.lerp(model.rotation.x, y * 0.3, 0.1); // Yukarı/aşağı
        };

        // 6. Animasyon Döngüsü
        function animate() {
            requestAnimationFrame(animate);
            renderer.render(scene, camera);
        }

        // Başlatma
        if (window.innerWidth > 768) {
            document.addEventListener('mousemove', mouseHandler);
        }
        animate();
    }

    // Astro sayfa yükleme olaylarını dinle
    document.addEventListener("DOMContentLoaded", initAboutComponent);
    document.addEventListener("astro:page-load", initAboutComponent);
</script>

<style>
    /* --- TEMEL BÖLÜM AYARLARI --- */
    .about-section {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .section-title { 
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.68rem; 
        text-transform: uppercase; 
        letter-spacing: 0.2em; 
        font-weight: 700; 
        color: #444446;
        margin-bottom: 0.1rem;
    }

    /* --- RESPONSIVE GRID DÜZENİ --- */
    .about-layout {
        display: grid;
        grid-template-columns: 1fr 240px; /* 3D karakter için alan ayır */
        gap: 2.5rem;
        align-items: center;
    }

    /* --- METİN ALANI STİLLERİ --- */
    .about-text p { 
        font-size: 1rem; 
        line-height: 1.8; 
        color: #86868b; 
        font-weight: 400; 
        margin: 0;
    }

    /* Canlı Yaş Sayacı */
    .age-inline-wrapper {
        color: #ffffff;
        font-weight: 500;
        white-space: nowrap;
    }

    #age-number {
        font-family: 'JetBrains Mono', monospace;
        font-size: 1rem;
        letter-spacing: -0.01em;
        background: linear-gradient(180deg, #ffffff 0%, #a1a1a6 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* --- 3D KARAKTER WIDGET STİLLERİ --- */
    .memoji-container-widget {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .memoji-3d-wrapper {
        width: 100%;
        height: 240px; /* Dik saçlar için daha fazla yükseklik */
        display: flex;
        justify-content: center;
        align-items: center;
        perspective: 1000px; /* Perspektif derinlik katma */
    }

    /* 3D Modelin Yüklendiği Canvas Konteyneri */
    #memoji-3d-canvas {
        width: 200px;
        height: 200px;
        display: block;
        transition: transform 0.1s ease-out; /* Fare takibi için yumuşak geçiş */
        will-change: transform;
        transform-style: preserve-3d;
        /* Hafif doğal gölge ile derinlik katma */
        filter: drop-shadow(0 15px 30px rgba(0, 0, 0, 0.4));
    }

    /* --- MOBİL OPTİMİZASYONU --- */
    @media (max-width: 768px) {
        .about-layout {
            grid-template-columns: 1fr; /* Mobilde dikey akış */
            gap: 1.5rem;
        }

        .memoji-3d-wrapper {
            justify-content: center;
            margin-top: 0.5rem;
            perspective: none; /* Mobilde 3D takibi kapat */
        }

        #memoji-3d-canvas {
            width: 160px; /* Mobilde küçült */
            height: 160px;
            transition: none; /* Mobilde takibi kapat */
        }

        .about-text p {
            font-size: 0.95rem; /* Daha konforlu okuma */
            line-height: 1.7;
        }
    }

    /* --- GİRİŞ ANİMASYONLARI --- */
    .word {
        display: inline-block;
        opacity: 0;
        filter: blur(10px);
        transform: translateY(8px);
        animation: revealText 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes revealText {
        to { opacity: 1; filter: blur(0px); transform: translateY(0); }
    }
    .delay-6 { animation-delay: 0.38s; }
</style>